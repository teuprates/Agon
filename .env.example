PORT=3500
SESSION_SECRET=gere-um-segredo-forte-para-producao

# Supabase: a chave de servidor é necessária para operações do backend.
# Use SUPABASE_SECRET_KEY ou SUPABASE_SERVICE_ROLE_KEY (nunca NEXT_PUBLIC_).
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_chave_anonima_publica_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_secreta_aqui

# Alternativas aceitas pelo código:
# NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anonima_publica_aqui
# SUPABASE_SECRET_KEY=sua_chave_secreta_de_servidor_aqui

# Inteligência Artificial - chave exclusivamente server-side (sem NEXT_PUBLIC_)
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-3.8-flash
